---
import ThemeToggle from '../components/ThemeToggle.astro';
import TypingSettingsBoot from '../components/TypingSettingsBoot.astro';
import LearningTrainer from '../features/typing/LearningTrainer.svelte';
import '../styles/global.css';
---

<!doctype html>
<html lang="vi">
  <head>
    <ThemeToggle boot />
    <TypingSettingsBoot />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Học gõ 10 ngón từ cơ bản - Go10Ngon</title>

    <meta
      name="description"
      content="Học gõ 10 ngón miễn phí theo từng cấp độ, từ hàng phím cơ sở đến luyện gõ tiếng Việt và tiếng Anh."
    />
  </head>

  <body>
    <main>
      <header class="site-header">
        <h1 class="site-mark">
          <a href="/">Go10Ngon</a>
        </h1>
        <div class="site-tools">
          <a class="site-link" href="/">
            Kiểm tra tốc độ
          </a>
          <ThemeToggle />
        </div>
      </header>
      <LearningTrainer client:load />
    </main>
  </body>
</html>

---
import TypingTrainer from '../features/typing/TypingTrainer.svelte';
import '../styles/global.css';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Go10Ngon - Luyện gõ 10 ngón</title>
    <meta name="description" content="Luyện gõ 10 ngón trực tuyến miễn phí." />
  </head>

  <body>
    <main>
      <h1>Go10Ngon</h1>
      <p>Website luyện gõ 10 ngón.</p>
      <TypingTrainer client:load />
      <nav class="home-navigation" aria-label="Chọn chế độ luyện gõ">
  <a href="/learn/">
    Học gõ 10 ngón theo cấp độ →
  </a>
</nav>
    </main>
  </body>
</html>
<style>
  .home-navigation {
    margin: var(--space-5) 0;
  }

  .home-navigation a {
    display: inline-flex;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .home-navigation a:hover {
    background: var(--color-surface-hover);
  }

  .home-navigation a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }
</style>